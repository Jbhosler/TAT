# Google Cloud Configuration
GCP_PROJECT_ID=tax-aware-transition-tool
GCP_PROJECT_NUMBER=406289788150
GCP_REGION=us-central1

# Database Configuration
# For Cloud SQL (production): Use connection name format: project:region:instance
# For local development: Use Cloud SQL Proxy or local PostgreSQL
DB_HOST=tax-aware-transition-tool:us-central1:tat-db-instance
DB_NAME=tat_database
DB_USER=tat_user
DB_PASSWORD=your_password_here
USE_CLOUD_SQL_PROXY=false

# Application Configuration
SECRET_KEY=your-secret-key-here-change-in-production
# AlphaVantage API key (for Equivalent Review). In production, use Secret Manager "Alpha-API"
ALPHAVANTAGE_API_KEY=
PASSCODE=007
API_PORT=8000

# Environment
ENVIRONMENT=development
